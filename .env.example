# Copy to .env.local for local development. Both are also set as Netlify
# environment variables for the deployed site.
#
# The anon key is public by design — it ships in the client bundle and RLS is
# what protects the data — but it is not committed, matching Dodo.
VITE_SUPABASE_URL=https://tpewzbkcmpttrhiuxwqp.supabase.co
VITE_SUPABASE_ANON_KEY=

# The MCP function at /mcp needs no third variable: it authenticates with the
# anon key above, and the only thing that key can reach without a signed-in
# session is the pitchstone_mcp_* surface, which derives the user from the
# caller's personal token. There is deliberately no service-role key anywhere.
